#!/usr/bin/env bash

# Constants
PREVIEW_LENGTH=60
MAX_RESPONSES=99999
DEFAULT_LIST_COUNT=10

# Check bash version (need 4.0+ for associative arrays)
if [ "${BASH_VERSINFO[0]}" -lt 4 ]; then
    cat >&2 <<EOF
Error: This script requires Bash 4.0 or higher (current: $BASH_VERSION)

macOS users: Install via Homebrew:
  brew install bash

Then ensure it's in your PATH, or update the shebang to:
  #!/opt/homebrew/bin/bash (Apple Silicon)
  #!/usr/local/bin/bash (Intel)
EOF
    exit 1
fi

# Function to generate preview text for responses
generate_preview() {
    local response="$1"
    # Get first non-empty line as preview (truncate if too long)
    # Use printf and avoid tr to preserve UTF-8 encoding
    local preview=$(printf '%s' "$response" | grep -m1 -v '^[[:space:]]*$' | cut -c1-$PREVIEW_LENGTH | sed 's/[\n\r]//g')
    if [ -z "$preview" ]; then
        preview="<empty response>"
    elif [ ${#preview} -eq $PREVIEW_LENGTH ]; then
        preview="${preview}..."
    fi
    echo "$preview"
}

# Function to convert timestamp to epoch (cross-platform)
timestamp_to_epoch() {
    local timestamp="$1"
    # Try GNU date first (Linux, Windows/WSL, Homebrew coreutils)
    if date -d "$timestamp" +%s >/dev/null 2>&1; then
        date -d "$timestamp" +%s
    # Try BSD date (macOS default)
    elif date -j -f "%Y-%m-%dT%H:%M:%S" "$timestamp" +%s >/dev/null 2>&1; then
        date -j -f "%Y-%m-%dT%H:%M:%S" "$(echo "$timestamp" | sed 's/\.[0-9]*Z$//')" +%s 2>/dev/null || echo "0"
    else
        echo "0"
    fi
}

# Function to format timestamp as "time ago" display
format_time_ago() {
    local timestamp="$1"
    local time_display=""
    if [[ -n "$timestamp" ]]; then
        # Calculate time ago
        local now_epoch=$(date +%s)
        local msg_epoch=$(timestamp_to_epoch "$timestamp")
        if [[ "$msg_epoch" == "0" ]]; then
            msg_epoch=$now_epoch
        fi
        local diff_sec=$((now_epoch - msg_epoch))

        if [[ $diff_sec -lt 60 ]]; then
            time_display=$(printf "[%4.1f sec ago]" "$diff_sec")
        elif [[ $diff_sec -lt 3600 ]]; then
            local diff_min=$(echo "scale=1; $diff_sec / 60" | bc -l 2>/dev/null || echo "$((diff_sec/60))")
            time_display=$(printf "[%4.1f min ago]" "$diff_min")
        else
            local diff_hr=$(echo "scale=2; $diff_sec / 3600" | bc -l 2>/dev/null || echo "$((diff_sec/3600))")
            time_display=$(printf "[%4.2f hrs ago]" "$diff_hr")
        fi
    fi
    echo "$time_display"
}

# Function to copy through an optional clipboard relay.
#
# This is useful when Claude Code runs on a remote Linux host over SSH/tmux but
# the clipboard belongs to the local machine. Hook stdout/stderr may be captured
# by Claude Code, so OSC52-style terminal output is not always reliable there.
copy_to_clipboard_relay() {
    local text="$1"
    local relay="${COPY_CLAUDE_CLIPBOARD_RELAY:-}"
    local token_file="${COPY_CLAUDE_CLIPBOARD_RELAY_TOKEN_FILE:-}"
    local temp_file status

    [ -n "$relay" ] || return 1
    command -v python3 >/dev/null 2>&1 || return 1

    temp_file=$(mktemp)
    printf '%s' "$text" > "$temp_file"

    python3 - "$relay" "$token_file" "$temp_file" <<'PYCLIENT'
import os
import socket
import sys
from pathlib import Path

relay, token_file, payload_file = sys.argv[1:4]
if ":" not in relay:
    raise SystemExit(1)

host, port_text = relay.rsplit(":", 1)
payload = Path(payload_file).read_bytes()
token = b""

if token_file:
    token = Path(os.path.expanduser(token_file)).read_text(encoding="utf-8").strip().encode()

try:
    with socket.create_connection((host, int(port_text)), timeout=2.0) as sock:
        sock.sendall(token + b"\n" + payload)
        sock.shutdown(socket.SHUT_WR)
        response = sock.recv(1024)
    if not response.startswith(b"OK"):
        raise SystemExit(1)
except Exception:
    raise SystemExit(1)
PYCLIENT
    status=$?
    rm -f "$temp_file"
    return "$status"
}

# Function to copy text to clipboard (cross-platform)
copy_to_clipboard() {
    local text="$1"

    if copy_to_clipboard_relay "$text"; then
        return 0
    elif command -v pbcopy >/dev/null 2>&1; then
        # macOS - printf preserves UTF-8 better than echo
        printf '%s' "$text" | pbcopy
    elif command -v xclip >/dev/null 2>&1; then
        # Linux - printf preserves UTF-8 better than echo
        printf '%s' "$text" | xclip -selection clipboard
    elif command -v clip.exe >/dev/null 2>&1; then
        # Windows/WSL - write to temp file with UTF-8 BOM then read back
        local temp_file=$(mktemp)
        printf '\xEF\xBB\xBF%s' "$text" > "$temp_file"
        powershell.exe -Command "Get-Content -Path '$(wslpath -w "$temp_file")' -Encoding UTF8 | Set-Clipboard"
        rm "$temp_file"
    else
        echo "No clipboard utility found (pbcopy, xclip, or clip.exe)" >&2
        exit 1
    fi
}

# Read hook input
INPUT=$(cat)

# Try to extract prompt without jq first for pattern matching
# This is a simple extraction that works for the basic case
PROMPT=""
if [[ "$INPUT" =~ \"prompt\":[[:space:]]*\"([^\"]+)\" ]]; then
    PROMPT="${BASH_REMATCH[1]}"
fi

# Check if this is a copy-response or c command (with optional arguments)
# Support /copy-response, /copy, and /c as shortcuts
if [[ ! "$PROMPT" =~ ^/(copy-response|copy|c)([[:space:]].*)?$ ]]; then
    exit 0  # Let other prompts proceed normally
fi

# Trim trailing whitespace from PROMPT for further processing
PROMPT=$(echo "$PROMPT" | sed 's/[[:space:]]*$//')

# Check if jq is installed (only needed when command matches)
if ! command -v jq >/dev/null 2>&1; then
    cat >&2 <<EOF
Error: jq is not installed. Please install jq to use this script.

Installation:
  macOS:    brew install jq
  Linux:    sudo apt-get install jq / sudo yum install jq
  Windows:  choco install jq
EOF
    exit 2
fi

# Now we can safely use jq to parse the full input
TRANSCRIPT_PATH=$(echo "$INPUT" | jq -r '.transcript_path')
PROMPT=$(echo "$INPUT" | jq -r '.prompt')

# Trim trailing whitespace again after jq parsing
PROMPT=$(echo "$PROMPT" | sed 's/[[:space:]]*$//')

# Parse the command
LIST_MODE=false
FIND_MODE=false
DEBUG_MODE=false
SEARCH_TERM=""
RESPONSE_NUM=1
LIST_COUNT=$DEFAULT_LIST_COUNT

if [[ "$PROMPT" =~ ^/(copy-response|copy|c)[[:space:]]+list([[:space:]]+([0-9]+))?$ ]]; then
    LIST_MODE=true
    if [ -n "${BASH_REMATCH[3]}" ]; then
        LIST_COUNT=${BASH_REMATCH[3]}
    fi
elif [[ "$PROMPT" =~ ^/(copy-response|copy|c)[[:space:]]+find[[:space:]]+\"([^\"]+)\"$ ]]; then
    FIND_MODE=true
    SEARCH_TERM="${BASH_REMATCH[2]}"
elif [[ "$PROMPT" =~ ^/(copy-response|copy|c)[[:space:]]+debug([[:space:]]+([0-9]+))?$ ]]; then
    DEBUG_MODE=true
    echo "DEBUG: Matched debug command" >&2
    if [ -n "${BASH_REMATCH[3]}" ]; then
        RESPONSE_NUM=${BASH_REMATCH[3]}
        echo "DEBUG: Set response num to ${BASH_REMATCH[3]}" >&2
    fi
elif [[ "$PROMPT" =~ ^/(copy-response|copy|c)[[:space:]]+([0-9]+)$ ]]; then
    RESPONSE_NUM=${BASH_REMATCH[2]}
fi

if [ -z "$TRANSCRIPT_PATH" ] || [ ! -f "$TRANSCRIPT_PATH" ]; then
    echo "No valid transcript path found" >&2
    exit 1
fi

# Get the last N assistant responses grouped by requestId (use LIST_COUNT if in list mode, otherwise all responses)
MAX_RESPONSES=$( [ "$LIST_MODE" = true ] && echo "$LIST_COUNT" || echo $MAX_RESPONSES )

# Group responses by requestId and concatenate fragments
declare -A response_groups
declare -a request_order

# Process transcript in forward order to build groups correctly
declare -A seen_requests
while read -r line; do
    if echo "$line" | jq -e '.message.role == "assistant"' >/dev/null 2>&1; then
        request_id=$(echo "$line" | jq -r '.requestId')
        content=$(echo "$line" | jq -r '.message.content[0].text // ""')

        # If we haven't seen this requestId before, initialize it
        if [[ -z "${seen_requests[$request_id]}" ]]; then
            seen_requests["$request_id"]=1
            response_groups["$request_id"]=""
        fi

        # Append content (processing in forward order)
        if [[ -n "$content" ]]; then
            if [[ -n "${response_groups[$request_id]}" ]]; then
                response_groups["$request_id"]+=$'\n'"$content"
            else
                response_groups["$request_id"]="$content"
            fi
        else
            # Empty response = newline
            response_groups["$request_id"]+=$'\n'
        fi
    fi
done < "$TRANSCRIPT_PATH"

# Detect reverse-cat command (tac on Linux/WSL, gtac on macOS with coreutils)
REVERSE_CAT="tac"
if ! command -v tac >/dev/null 2>&1; then
    if command -v gtac >/dev/null 2>&1; then
        REVERSE_CAT="gtac"
    else
        cat >&2 <<EOF
Error: Neither 'tac' nor 'gtac' command found.

macOS users: Install via Homebrew:
  brew install coreutils

This will provide the 'gtac' command (GNU tac).
EOF
        exit 1
    fi
fi

# Get request order (newest first) and timestamps by processing in reverse
declare -A request_timestamps
while read -r line; do
    if echo "$line" | jq -e '.message.role == "assistant"' >/dev/null 2>&1; then
        request_id=$(echo "$line" | jq -r '.requestId')
        timestamp=$(echo "$line" | jq -r '.timestamp // .message.timestamp // ""')

        # Add to order if not already added and response has content
        if [[ ! " ${request_order[@]} " =~ " ${request_id} " ]]; then
            # Only add if the response group has actual content (not just whitespace/newlines)
            # Use printf to preserve UTF-8 encoding and avoid tr which can corrupt multibyte chars
            cleaned_content=$(printf '%s' "${response_groups[$request_id]}" | sed 's/[[:space:]]//g')
            if [[ -n "$cleaned_content" ]]; then
                request_order+=("$request_id")
                request_timestamps["$request_id"]="$timestamp"
            fi
        fi
    fi
done < <($REVERSE_CAT "$TRANSCRIPT_PATH")

# Build final responses array from grouped content (limit to MAX_RESPONSES)
RESPONSES=()
for request_id in "${request_order[@]}"; do
    if [[ ${#RESPONSES[@]} -lt $MAX_RESPONSES ]]; then
        RESPONSES+=("${response_groups[$request_id]}")
    else
        break
    fi
done

if [ ${#RESPONSES[@]} -eq 0 ]; then
    echo "No assistant text responses found" >&2
    exit 1
fi

# Handle find mode
if [ "$FIND_MODE" = true ]; then
    echo "Searching for \"$SEARCH_TERM\":" >&2
    found_count=0
    for i in $(seq $((${#RESPONSES[@]}-1)) -1 0); do
        # Case-insensitive search in response content
        if echo "${RESPONSES[$i]}" | grep -qi "$SEARCH_TERM"; then
            found_count=$((found_count + 1))
            PREVIEW=$(generate_preview "${RESPONSES[$i]}")
            # Get timestamp for this response
            req_id="${request_order[$i]}"
            timestamp="${request_timestamps[$req_id]}"
            time_display=$(format_time_ago "$timestamp")
            # Pad response number to align
            num_display=$(printf "%3d" $((i+1)))
            echo "  $num_display $time_display: $PREVIEW" >&2
        fi
    done
    if [[ $found_count -eq 0 ]]; then
        echo "No responses found matching \"$SEARCH_TERM\"" >&2
    else
        echo "Found $found_count matching responses" >&2
    fi
    exit 2  # Use exit 2 to block and show stderr
fi

# Handle list mode
if [ "$LIST_MODE" = true ]; then
    echo "Available responses (1-${#RESPONSES[@]}):" >&2
    # Display in reverse order (highest numbers first)
    for i in $(seq $((${#RESPONSES[@]}-1)) -1 0); do
        PREVIEW=$(generate_preview "${RESPONSES[$i]}")
        # Get timestamp for this response
        req_id="${request_order[$i]}"
        timestamp="${request_timestamps[$req_id]}"
        time_display=$(format_time_ago "$timestamp")
        # Pad response number to align
        num_display=$(printf "%3d" $((i+1)))
        echo "  $num_display $time_display: $PREVIEW" >&2
    done
    exit 2  # Use exit 2 to block and show stderr
fi

# If response number is out of range, show available options
if [ "$RESPONSE_NUM" -gt "${#RESPONSES[@]}" ] || [ "$RESPONSE_NUM" -lt 1 ]; then
    echo "Invalid response number $RESPONSE_NUM. Available responses (1-${#RESPONSES[@]}):" >&2
    for i in "${!RESPONSES[@]}"; do
        PREVIEW=$(generate_preview "${RESPONSES[$i]}")
        echo "  $((i+1)): $PREVIEW" >&2
    done
    exit 2  # Use exit 2 to block and show stderr
fi

# Get the selected response (adjust for 0-based indexing)
SELECTED_RESPONSE="${RESPONSES[$((RESPONSE_NUM-1))]}"

# Handle debug mode
if [ "$DEBUG_MODE" = true ]; then
    echo "=== DEBUG MODE ===" >&2
    echo "Selected response content:" >&2
    printf '%s\n' "$SELECTED_RESPONSE" >&2
    echo "" >&2
    echo "Byte count: $(printf '%s' "$SELECTED_RESPONSE" | wc -c)" >&2
    echo "Character count: $(printf '%s' "$SELECTED_RESPONSE" | wc -m)" >&2
    echo "Hexdump first 100 bytes:" >&2
    printf '%s' "$SELECTED_RESPONSE" | head -c 100 | hexdump -C >&2
    echo "" >&2
    echo "Copying to clipboard..." >&2
    # Continue to clipboard copy then exit with code 2 to show stderr
fi

# Copy to clipboard
copy_to_clipboard "$SELECTED_RESPONSE"

# Block the prompt from being processed and show success message
if [ "$DEBUG_MODE" = true ]; then
    # Exit with code 2 to ensure stderr debug output is shown to user
    exit 2
elif [ "$RESPONSE_NUM" -eq 1 ]; then
    echo '{"decision": "block", "reason": "✅ 最新回复已复制 Latest response copied!"}'
else
    echo '{"decision": "block", "reason": "✅ 回复 #'"$RESPONSE_NUM"' 已复制 Response #'"$RESPONSE_NUM"' copied!"}'
fi
